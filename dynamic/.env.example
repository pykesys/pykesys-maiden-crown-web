# Django Settings
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,maidencrownpress.com

# Database
DB_NAME=maiden_crown_db
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Stripe Payment Integration
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AWS S3 for Digital Products
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=maiden-crown-digital-products
AWS_S3_REGION_NAME=us-east-1

# Email Configuration (SendGrid)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@maidencrownpress.com

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# Site Configuration
SITE_URL=https://maidencrownpress.com
CONTACT_EMAIL=contact@maidencrownpress.com

# Security (Production only - set to False in development)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# CORS (if using separate frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://maidencrownpress.com
